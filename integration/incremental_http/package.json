{
  "name": "absinthe-incremental-http-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "prettier --check '*.mjs' package.json relay.config.json 'relay/*.js'",
    "test": "node --unhandled-rejections=strict --test --test-concurrency=1 --test-timeout=30000 client.test.mjs relay.test.mjs multipart.test.mjs",
    "relay:compile": "relay-compiler --noWatchman"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@apollo/client": "4.3.4",
    "graphql": "16.12.0",
    "relay-runtime": "21.0.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "graphql-reference": "npm:graphql@17.0.2",
    "prettier": "3.8.1",
    "relay-compiler": "21.0.1"
  }
}
