diff --git a/src/link/http/__tests__/readMultipartBody.test.ts b/src/link/http/__tests__/readMultipartBody.test.ts
new file mode 100644
index 0000000..953a9f0
--- /dev/null
+++ b/src/link/http/__tests__/readMultipartBody.test.ts
@@ -0,0 +1,48 @@
+import { readMultipartBody } from "../parseAndCheckHttpResponse.js";
+
+test("propagates a rejected reader cancellation through the multipart promise", async () => {
+  const error = new Error("cancel failed");
+  const next = jest.fn();
+  const body = new ReadableStream({
+    start(controller) {
+      controller.enqueue(
+        new TextEncoder().encode(
+          '\r\n--graphql\r\nContent-Type: application/json\r\n\r\n{"data":{"value":1}}\r\n--graphql--'
+        )
+      );
+    },
+    cancel() {
+      return Promise.reject(error);
+    },
+  });
+
+  await expect(
+    readMultipartBody(
+      new Response(body, {
+        headers: { "content-type": "multipart/mixed; boundary=graphql" },
+      }),
+      next
+    )
+  ).rejects.toBe(error);
+  expect(next).toHaveBeenCalledWith({ data: { value: 1 } });
+});
+
+test("retains the read error when canceling an already errored multipart stream", async () => {
+  const error = new DOMException("request aborted", "AbortError");
+  const next = jest.fn();
+  const body = new ReadableStream({
+    start(controller) {
+      controller.error(error);
+    },
+  });
+
+  await expect(
+    readMultipartBody(
+      new Response(body, {
+        headers: { "content-type": "multipart/mixed; boundary=graphql" },
+      }),
+      next
+    )
+  ).rejects.toBe(error);
+  expect(next).not.toHaveBeenCalled();
+});
