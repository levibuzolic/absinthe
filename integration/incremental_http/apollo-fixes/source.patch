+describe("streams introduced inside streamed items", () => {
+  test.each([
+    { initialCount: 0, sameChunk: false },
+    { initialCount: 1, sameChunk: false },
+    { initialCount: 0, sameChunk: true },
+    { initialCount: 1, sameChunk: true },
+  ])("preserves item positions with %j", ({ initialCount, sameChunk }) => {
+    const query = gql`
+      query {
+        friendList @stream(initialCount: 0) {
+          scalarList @stream(initialCount: ${initialCount})
+        }
+      }
+    `;
+    const request = new GraphQL17Alpha9Handler().startRequest({ query });
+    request.handle(undefined, {
+      data: { friendList: [] },
+      pending: [{ id: "outer", path: ["friendList"] }],
+      hasNext: true,
+    });
+
+    const firstPrefix = initialCount ? ["first prefix"] : [];
+    const secondPrefix = initialCount ? ["second prefix"] : [];
+    const parent = {
+      id: "outer",
+      items: [{ scalarList: firstPrefix }, { scalarList: secondPrefix }],
+    };
+    const tails = [
+      { id: "second", items: ["second tail"] },
+      { id: "first", items: ["first tail"] },
+    ];
+    const completed = [{ id: "first" }, { id: "second" }, { id: "outer" }];
+
+    let result = request.handle(undefined, {
+      pending: [
+        { id: "first", path: ["friendList", 0, "scalarList"] },
+        { id: "second", path: ["friendList", 1, "scalarList"] },
+      ],
+      incremental: sameChunk ? [parent, ...tails] : [parent],
+      ...(sameChunk ? { completed } : {}),
+      hasNext: !sameChunk,
+    });
+
+    if (!sameChunk) {
+      expect(result.data).toEqual({
+        friendList: [{ scalarList: firstPrefix }, { scalarList: secondPrefix }],
+      });
+
+      // Cached tails must not determine the server's next stream position.
+      result = request.handle(
+        {
+          friendList: [
+            { scalarList: [...firstPrefix, "stale", "stale"] },
+            { scalarList: [...secondPrefix, "stale", "stale"] },
+          ],
+        },
+        { incremental: tails, completed, hasNext: false }
+      );
+    }
+
+    expect(result.data).toEqual({
+      friendList: [
+        { scalarList: [...firstPrefix, "first tail"] },
+        { scalarList: [...secondPrefix, "second tail"] },
+      ],
+    });
+    expect(request.hasNext).toBe(false);
+  });
+});
