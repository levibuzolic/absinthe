+  private initializeStreams(data: any, path: ReadonlyArray<string | number>) {
+    for (const pending of this.pendingMap.values()) {
+      if (
+        pending.id in this.streamPositions ||
+        !path.every((key, index) => pending.path[index] === key)
+      ) {
+        continue;
+      }
+
+      // Use only the delivered prefix: cached arrays can contain unseen tails.
+      const value = pending.path
+        .slice(path.length)
+        .reduce((value, key) => value?.[key], data);
+
+      if (Array.isArray(value)) {
+        this.streamPositions[pending.id] = value.length;
+      }
+    }
+  }
